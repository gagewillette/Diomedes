# Public URL the app is served from (controls Secure cookies behind the tunnel)
APP_URL=https://docs.example.com

# Session signing secret — generate with: openssl rand -hex 32
APP_SECRET=change-me

# Postgres credentials (db container is initialized with these on first run)
POSTGRES_DB=diomedes
POSTGRES_USER=diomedes
POSTGRES_PASSWORD=change-me

# Image tag docker compose runs — bump when you release (see scripts/release.sh)
DIOMEDES_VERSION=1.1.0

# Semantic search (optional). When true, search combines vector similarity with
# full-text ranking and pages are embedded in the background on save. When
# false, search is pure Postgres full-text — zero extra compute, no API calls,
# and the ollama container below is never created. Requires the pgvector db
# image (see docker-compose.example.yml) and `npm run backfill:embeddings` for
# pages that already exist.
SEMANTIC_SEARCH_ENABLED=false

# Which optional compose services to run. "ollama" starts a local embedding
# server that downloads its own model on first boot — no Ollama install on the
# host, nothing to pull by hand. Leave empty to run no optional services.
# Set this together with SEMANTIC_SEARCH_ENABLED above; they are one decision.
COMPOSE_PROFILES=

# Embedding provider. The defaults below match the bundled ollama container and
# need no API key. To use OpenAI instead: clear COMPOSE_PROFILES, blank out
# EMBEDDING_API_URL/MODEL/DIMENSIONS, and set OPENAI_API_KEY.
#
# EMBEDDING_MODEL is what the ollama container downloads as well as what the
# app asks for, and EMBEDDING_DIMENSIONS must match that model's native width
# (nomic-embed-text is 768). Changing dimensions means rebuilding page_chunks:
# DROP TABLE page_chunks, restart, then `npm run backfill:embeddings`.
OPENAI_API_KEY=
EMBEDDING_API_URL=http://ollama:11434/v1/embeddings
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768

# PPTX -> PDF conversion runs LibreOffice, which the app image already ships.
# Only set SOFFICE_PATH when the binary is somewhere unusual — running the
# server on a host, say, where LibreOffice is installed outside PATH. When no
# binary is found the "store as PDF" option is disabled in the editor and the
# PPTX is kept in its original format.
# SOFFICE_PATH=/Applications/LibreOffice.app/Contents/MacOS/soffice
# PDF_CONVERT_TIMEOUT_MS=120000
