# Public URL the app is served from (controls Secure cookies behind the tunnel)
APP_URL=https://docs.example.com

# Session signing secret — generate with: openssl rand -hex 32
APP_SECRET=change-me

# Postgres credentials (db container is initialized with these on first run)
POSTGRES_DB=diomedes
POSTGRES_USER=diomedes
POSTGRES_PASSWORD=change-me

# Image tag docker compose runs — bump when you release (see scripts/release.sh)
DIOMEDES_VERSION=1.1.0

# Semantic search (optional). When true and an OpenAI API key is set, search
# combines vector similarity with full-text ranking and pages are embedded in
# the background on save. When false, search is pure Postgres full-text —
# zero extra compute, no API calls. Requires the pgvector db image (see
# docker-compose.example.yml) and `npm run backfill:embeddings` for existing pages.
SEMANTIC_SEARCH_ENABLED=false

# Embedding provider. Leave EMBEDDING_API_URL empty to use OpenAI (needs a key).
# To run embeddings locally with no API key, install Ollama, then:
#   ollama pull nomic-embed-text
#   EMBEDDING_API_URL=http://localhost:11434/v1/embeddings
#   EMBEDDING_MODEL=nomic-embed-text
#   EMBEDDING_DIMENSIONS=768
# EMBEDDING_DIMENSIONS must match the model's native width; changing it means
# rebuilding page_chunks (DROP TABLE page_chunks, restart, then backfill).
OPENAI_API_KEY=
EMBEDDING_API_URL=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=
